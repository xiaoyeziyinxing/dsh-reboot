{
  "name": "dsh-reboot",
  "version": "0.2.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "description": "DeepSeek Harness 一键重启插件：restart_host 工具 + 对话框重启按钮；CLI 宿主看门狗按原命令行原端口重启（页面自动恢复），桌面端自动重启整个客户端（TypeScript + vitest）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "MIT",
  "author": "xiaoyeziyinxing",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoyeziyinxing/dsh-restart.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "restart",
    "agent"
  ],
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./client/service": "./lib/client.js",
    "./client/api": "./lib/client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
